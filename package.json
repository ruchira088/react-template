{
  "name": "react-template",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "sass-embedded": "^1.103.1",
    "simple-git": "^3.36.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/react": "^10.70.0",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.2.1",
    "lucide-react": "^1.33.0",
    "luxon": "^3.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "npm run env-vars && VITE_MOCK_API=true react-router build",
    "ci:checks": "npm run typecheck && npm run lint && npm run test:coverage",
    "env-vars": "node scripts/env-vars.mjs",
    "lint": "oxlint app tests",
    "lint:fix": "oxlint app tests --fix",
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "npm run env-vars && VITE_MOCK_API=true react-router dev --host 0.0.0.0",
    "start:dev": "npm run env-vars && VITE_API_URL=https://api.react-template.ruchij.com react-router dev --host 0.0.0.0",
    "start:local": "npm run env-vars && VITE_API_URL=https://api.localhost react-router dev",
    "start:staging": "npm run env-vars && VITE_API_URL=https://api.staging.react-template.ruchij.com react-router dev --host 0.0.0.0",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "typecheck": "react-router typegen && tsc"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true
  }
}
