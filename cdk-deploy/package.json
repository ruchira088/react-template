{
  "name": "cdk-deploy",
  "version": "0.1.0",
  "bin": {
    "cdk-deploy": "bin/cdk-deploy.js"
  },
  "scripts": {
    "build": "tsc",
    "cdk": "cdk",
    "cdk-deploy": "cdk deploy --require-approval=never",
    "deploy": "npm run build && npm run cdk-deploy"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "aws-cdk": "^2.1133.0",
    "react-app-cdk-deploy": "github:ruchira088/react-app-cdk-deploy#v1"
  },
  "allowScripts": {
    "github:ruchira088/react-app-cdk-deploy": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
